# Plantilla de variables de entorno.
# Copia este archivo a .env.development / .env.production y rellena los valores.
# Las variables con prefijo NUXT_ sobrescriben runtimeConfig (nuxt.config.ts).
# NUXT_PUBLIC_* se exponen al navegador: nunca pongas secretos ahí.

# --- Públicas (cliente + servidor) ---
NUXT_PUBLIC_APP_ENV=
NUXT_PUBLIC_SITE_URL=
# URL base del backend (Spring). La usan el navegador y las server routes (BFF).
NUXT_PUBLIC_API_BASE=
# Site key de Cloudflare Turnstile. Vacia = sin widget (se envia "dev").
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Privadas (solo servidor) ---
NUXT_API_SECRET=
